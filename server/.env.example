PORT=5001
# MongoDB Atlas: Cluster0 -> Connect -> Drivers -> copy the connection string
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smartqa
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Google Cloud -> Google Auth Platform -> Clients -> your Web client's Client ID
GOOGLE_CLIENT_ID=
